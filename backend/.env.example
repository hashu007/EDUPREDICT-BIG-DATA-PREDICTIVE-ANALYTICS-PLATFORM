# ==============================================================================
# EduPredict - Backend Local Environment Variables
# ==============================================================================
# Copy this file to .env inside the /backend directory:
#   cp .env.example .env

# Local MongoDB Connection String
# Default unauthenticated local instance:
MONGO_URI=mongodb://127.0.0.1:27017/edupredict_db

# If using MongoDB user authentication:
# MONGO_URI=mongodb://adminUser:StrongPassword123@127.0.0.1:27017/edupredict_db?authSource=admin

# Flask API Server Port
PORT=5000

# Set this to a unique, random secret before deployment.
FLASK_SECRET_KEY=replace-with-a-random-secret

# Python Environment
PYTHONUNBUFFERED=1
FLASK_ENV=development
